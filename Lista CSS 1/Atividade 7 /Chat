
<!DOCTYPE html>
<html lang="pt-br">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Chat</title>

    <style>
        * {
            box-sizing: border-box;
        }

        body {
            font-family: Arial, sans-serif;
            background-color: white;
        }

        /* Área principal do chat */
        .chat {
            width: 255px;
            height: 322px;
            border: 1px solid #ccc;
            border-radius: 5px;
            padding: 8px;
            position: absolute;
            right: 15px;
            top: 100px;
            overflow-y: auto;
        }

        /* Caixa de cada mensagem */
        .mensagem {
            width: 100%;
            min-height: 40px;
            border: 1px solid #ccc;
            border-radius: 5px;
            margin-bottom: 8px;
            padding: 7px;
            position: relative;
            overflow: hidden;
        }

        /* Mensagens recebidas */
        .recebida {
            background-color: white;
        }

        /* Mensagens enviadas */
        .enviada {
            background-color: #c9f7cc;
            text-align: right;
        }

        /* Nome do remetente */
        .nome {
            font-size: 9px;
            color: #999;
            margin-bottom: 3px;
        }

        /* Imagens dos usuários */
        .avatar {
            width: 25px;
            height: 25px;
            object-fit: contain;
        }

        /* Avatar da mensagem recebida */
        .recebida .avatar {
            float: left;
            margin-right: 10px;
        }

        /* Avatar da mensagem enviada */
        .enviada .avatar {
            float: right;
            margin-left: 10px;
        }

        /* Texto da mensagem */
        .texto {
            font-size: 12px;
            padding-top: 4px;
        }

        /* Horário */
        .hora {
            font-size: 8px;
            color: #999;
            position: absolute;
            bottom: 3px;
            right: 7px;
        }

        /* Área de digitação */
        .entrada {
            border: 1px solid #ccc;
            border-radius: 5px;
            padding: 8px;
            margin-top: 5px;
        }

        textarea {
            width: 100%;
            height: 52px;
            resize: none;
            border: 1px solid #ccc;
            padding: 7px;
            font-family: monospace;
            font-size: 12px;
        }

        .botao {
            text-align: right;
            margin-top: 3px;
        }

        button {
            cursor: pointer;
        }
    </style>
</head>

<body>

    <div class="chat" id="chat">

        <!-- Primeira mensagem -->
        <div class="nome">Pedro Silva</div>
        <div class="mensagem recebida">
            <img src="menino.png" class="avatar">
            <div class="texto">Olá, tudo bem?</div>
            <span class="hora">00:50</span>
        </div>

        <!-- Segunda mensagem -->
        <div class="nome">Eu</div>
        <div class="mensagem enviada">
            <img src="menina.png" class="avatar">
            <div class="texto">Estou bem sim, e você?</div>
            <span class="hora">00:55</span>
        </div>

        <!-- Terceira mensagem -->
        <div class="nome">Pedro Silva</div>
        <div class="mensagem recebida">
            <img src="menino.png" class="avatar">
            <div class="texto">
                Vamos sair hoje? sabe conversar e
                Lorem ipsum dolor sit amet
                consectetur adipisicing elit.
                Illum ducimus
            </div>
            <span class="hora">01:01</span>
        </div>

        <!-- Quarta mensagem -->
        <div class="nome">Eu</div>
        <div class="mensagem enviada">
            <img src="menina.png" class="avatar">
            <div class="texto">Criatura ......</div>
            <span class="hora">00:55</span>
        </div>

        <!-- Campo de digitação -->
        <div class="entrada">
            <textarea id="mensagem" placeholder="Digite sua mensagem"></textarea>

            <div class="botao">
                <button onclick="enviarMensagem()">Enviar</button>
            </div>
        </div>

    </div>

    <script>
        function enviarMensagem() {
            let campo = document.getElementById("mensagem");
            let texto = campo.value.trim();

            if (texto === "") {
                return;
            }

            let chat = document.getElementById("chat");

            let nome = document.createElement("div");
            nome.className = "nome";
            nome.textContent = "Eu";

            let mensagem = document.createElement("div");
            mensagem.className = "mensagem enviada";

            let avatar = document.createElement("img");
            avatar.src = "menina.png";
            avatar.className = "avatar";

            let conteudo = document.createElement("div");
            conteudo.className = "texto";
            conteudo.textContent = texto;

            let hora = document.createElement("span");
            hora.className = "hora";
            hora.textContent = "Agora";

            mensagem.appendChild(avatar);
            mensagem.appendChild(conteudo);
            mensagem.appendChild(hora);

            let entrada = chat.querySelector(".entrada");

            chat.insertBefore(nome, entrada);
            chat.insertBefore(mensagem, entrada);

            campo.value = "";
            chat.scrollTop = chat.scrollHeight;
        }
    </script>

</body>
</html>
